# HubSpot private app token (Settings, Integrations, Private Apps).
# Scopes: crm.objects.contacts, crm.objects.companies, crm.objects.deals (read + write).
HUBSPOT_PRIVATE_APP_TOKEN=

# Client secret of the same private app; signs webhook deliveries
# (X-HubSpot-Signature-v3).
HUBSPOT_CLIENT_SECRET=

# Public URL HubSpot calls for webhooks. Signature verification uses the exact
# URL, so this must match the webhook target configured in HubSpot.
WEBHOOK_PUBLIC_URL=http://localhost:8040/webhooks/hubspot

# Anthropic API key for the Claude agent layer.
ANTHROPIC_API_KEY=

# Model used by the agent layer.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres connection string. Matches docker/docker-compose.yml (host port 5461).
DATABASE_URL=postgresql://cadence:cadence@localhost:5461/cadence

# Redis connection string for BullMQ. Matches docker/docker-compose.yml (host port 6386).
REDIS_URL=redis://localhost:6386
